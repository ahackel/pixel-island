{
  "name": "pixel-island",
  "version": "0.1.0",
  "private": true,
  "description": "A shipwreck survivor on a tiny island, built on pixel-engine",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run check:engine && tsc --noEmit && vite build",
    "check:engine": "node engine/scripts/check-boundary.mjs",
    "preview": "vite preview --host",
    "test": "node --import ./scripts/pixel-alias.mjs --test src/*.test.ts engine/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
